# Runtime secret, configured separately for local development and Sites hosting.
STRIDE_ENCRYPTION_KEY=
# Optional versioned rotation: retain old keys until stored envelopes have migrated.
# Use random secrets of at least 32 characters; IDs must contain only letters/digits/_/-.
# STRIDE_ENCRYPTION_KEY remains the legacy decrypt key; never reuse its reserved ID.
STRIDE_ENCRYPTION_KEY_ID=
STRIDE_ENCRYPTION_KEYS=
